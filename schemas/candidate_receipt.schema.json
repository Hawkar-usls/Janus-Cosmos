{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Janus Cosmos FractalGPT Receipt",
  "type": "object",
  "required": ["schema", "status", "astronomical_discovery", "observed_score", "p_empirical", "semantic_analysis"],
  "properties": {
    "schema": {"type": "string"},
    "status": {"enum": ["NO_CANDIDATE", "CANDIDATE_ONLY"]},
    "astronomical_discovery": {"const": false},
    "observed_score": {"type": "number"},
    "p_empirical": {"type": "number", "minimum": 0, "maximum": 1},
    "semantic_analysis": {"const": false}
  }
}
