  "control_directions": [
    {
      "formula": "RA+40 degrees, unchanged Dec",
      "role": "coverage_control"
    },
    {
      "formula": "RA+80 degrees, unchanged Dec",
      "role": "coverage_control"
    }
  ],
  "search": {
    "all_directions": 15,
    "max_rows_per_direction": 500,
    "half_width_declination_deg": 1.5,
    "half_width_ra_deg_formula": "1.5 / max(0.12,cos(dec))",
    "cone_radii_for_report_deg": [
      0.05,
      0.1,
      0.5,
      1.5
    ],
    "candidate_selection": "Spherical separation using true original catalog coordinates; do not infer primary beam from sky center alone.",
    "per_query_timeout_seconds": 25,
    "max_parallel_requests": 3,
    "max_raw_response_bytes": 10000000,
    "known_columns_from_doc": [
      "obs_id",
      "obs_collection",
      "s_ra",
      "s_dec",
      "ra_hms",
      "dec_dms",
      "frequency",
      "bandwidth",
      "access_url",
      "data_flag",
      "access_estsize"
    ],
    "prefer_metadata_columns": [
      "obs_id",
      "obs_collection",
      "s_ra",
      "s_dec",
      "t_min",
      "t_max",
      "instrument_name",
      "facility_name",
      "frequency",
      "bandwidth",
      "access_url",
      "data_flag",
      "access_estsize",
      "ra_hms",
      "dec_dms"
    ],
    "require_instrument_parkes_where_available": true,
    "source_metadata_schema_probe_before_query": true,
    "fallback_request_methods": [
      "GET",
      "POST"
    ],
    "no_private_credentials": true
  },
  "provenance_gates": {
    "query_results_are_metadata_not_antenna_pointing": true,
    "source_is_not_independent_contemporaneous_bl_off": true,
    "real_spectral_bytes_downloaded": 0,
    "no_source_spectrum_without_true_instrument_beam": true,
    "no_technosignature_or_nondetection_claim": true,
    "no_legacy_threshold_tuning": true,
    "production_unchanged": true
  },
  "outcomes": {
    "if_available": "Report Parkes-only metadata candidates by separation, observing frequency, time, project and available access URL, required per-feed/pointing checks; preserve exact ADQL and output digest",
    "if_unavailable": "Mark ATOA TAP UNAVAILABLE, do not infer zero coverage. Escalate route to open ATNFDATSUP-1670 / CASDA, keeping existing historic BL R2A negative catalog footprint separate."
  },
  "outputs": [
    "atoa_schema.json",
    "atoa_candidates.json",
    "atoa_query_receipts.json",
    "r2c_gate_report.json"
  ]
}
