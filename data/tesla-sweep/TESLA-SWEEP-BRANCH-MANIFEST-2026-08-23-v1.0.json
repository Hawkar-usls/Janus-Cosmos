      "integer_ratio_frequency_spacing",
      "repeating_symbol_like_blocks",
      "low_entropy_nonrandom_sequences"
    ],
    "admission_rule": "A numerical pattern can advance only if it survives OFF-source, RFI, timing, instrumental and repeatability controls."
  },
  "falsification_pipeline": [
    "INGEST_RAW_OR_HIGH_FIDELITY_DATA",
    "VERIFY_TIME_FREQUENCY_METADATA",
    "ON_SOURCE_TEST",
    "OFF_SOURCE_TEST",
    "REPEAT_TEST",
    "MULTI_SITE_OR_MULTI_INSTRUMENT_TEST_WHERE_POSSIBLE",
    "KNOWN_RFI_BAND_TEST",
    "EPHEMERIS_AND_SATELLITE_TEST",
    "DOPPLER_MODEL_TEST",
    "DISPERSION_TEST",
    "PERIODICITY_AND_SEQUENCE_TEST",
    "NATURAL_SOURCE_CONTROL",
    "INSTRUMENTAL_CONTROL",
    "BLIND_REPLAY",
    "CLASSIFY"
  ],
  "classification_states": [
    "KNOWN_NATURAL",
    "KNOWN_ARTIFICIAL",
    "LIKELY_RFI",
    "INSTRUMENTAL",
    "UNCONFIRMED_NONREPEATING",
    "REPEATING_UNEXPLAINED",
    "CANDIDATE_REQUIRES_INDEPENDENT_REPLICATION",
