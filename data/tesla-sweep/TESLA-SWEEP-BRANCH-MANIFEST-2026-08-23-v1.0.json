  },
  "first_gate": "TESLA_SWEEP_OPEN_SIGNAL_CORPUS_GATE",
  "first_gate_goal": "Build a provenance-preserving corpus of known natural, known artificial, known RFI and unresolved public signals before blind scoring.",
  "scientific_boundary": "TESLA SWEEP searches for unexplained signal structure. It does not assume extraterrestrial origin, intelligence, or a connection to Tesla's historical observations.",
  "janus_relation": {
    "cousteau": "Shares measurement-first, provenance-first and falsification-first discipline.",
