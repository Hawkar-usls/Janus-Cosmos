  ],
  "positive_controls": [
    {
      "class": "KNOWN_ARTIFICIAL_DEEP_SPACE",
      "example": "Voyager carrier",
      "purpose": "Confirm that the pipeline can recognize an artificial narrowband signal arriving from deep space without interpreting it as unknown intelligence."
    },
    {
      "class": "KNOWN_NATURAL_PLANETARY",
      "example": "Jupiter radio bursts",
      "purpose": "Validate natural burst morphology handling."
    },
    {
      "class": "KNOWN_NATURAL_TRANSIENT",
      "example": "FRB / pulsar-like public data",
      "purpose": "Validate dispersion, pulse and repetition handling."
    }
  ],
  "negative_controls": [
    "known_satellite_bands",
    "known_ground_RFI",
    "off_source_observations",
    "instrumental_spurs",
    "time_shifted_and_scrambled_controls"
  ],
  "seed_open_corpora": [
    "Breakthrough Listen public observations",
    "Radio JOVE public observations",
    "e-CALLISTO public solar radio observations",
