  "status": "ACTIVE_RESEARCH_BRANCH",
  "mission": "Blindly collect and test unusual signals available in open data, without restricting the search to Nikola Tesla's reported 1-2-3-4 interpretation.",
  "principle": "PATTERN_IS_NOT_PROOF",
  "historical_firewall": {
    "tesla_report": "HISTORICAL_SIGNAL_REPORT",
    "raw_1899_waveform_available": false,
    "rule": "Historical descriptions may seed morphology tests but may not receive evidentiary authority over modern measurements."
  },
  "scope": {
    "domains": [
      "radio_astronomy",
      "SETI_open_data",
      "planetary_radio",
      "solar_radio",
      "FRB_and_transients",
      "deep_space_spacecraft_carriers",
      "terrestrial_RFI_controls"
    ],
    "signal_morphologies": [
      "narrowband_carrier",
      "doppler_drift",
      "periodic_pulse_train",
      "burst_grouping",
      "frequency_comb",
      "chirp",
      "dispersion",
      "broadband_transient",
      "low_entropy_sequence",
      "arithmetic_interval_structure",
      "geometric_interval_structure",
      "prime_like_grouping",
      "symbol_like_repetition"
    ]
  },
  "tesla_number_gate": {
    "enabled": true,
    "not_limited_to_literal_1234": true,
    "tests": [
